-- ========== UTILITY ==========
-- Defined after State so State.errorHandler is always valid when called.
local function safeCall(func, context, suppressError)
    local function handler(err)
        return debug.traceback(tostring(err), 2)
    end
    local success, result = xpcall(func, handler)
    if not success then
        if State and State.errorHandler then
            State.errorHandler:Log(context or "Unknown", result, "Error", suppressError)
        else
            warn("[safeCall] " .. tostring(result))
        end
        return nil
    end
    return result
end

-- ========== HEAD LOCK (ALWAYS ACTIVE) ==========
local FlintLock  = require(ReplicatedStorage.Modules.Weapons.Flintlock)
local MeleeBase  = require(ReplicatedStorage.Modules.Weapons.MeleeBase)
local originalBayonetHitCheck, originalMeleeHitCheck

-- Cached zombie head lookup: zombieModel -> headPart
-- Invalidated automatically when the head part leaves the workspace.
local zombieHeadCache = {}

local function getZombieHead(zombieModel)
    local cached = zombieHeadCache[zombieModel]
    if cached and cached.Parent then
        return cached
    end
    -- Search and cache
    for _, child in ipairs(zombieModel:GetChildren()) do
        if child.Name == "Head" and (child:IsA("Part") or child:IsA("MeshPart")) then
            zombieHeadCache[zombieModel] = child
            -- Invalidate when the part is removed
            child.AncestryChanged:Connect(function()
                if not child.Parent then
                    zombieHeadCache[zombieModel] = nil
                end
            end)
            return child
        end
    end
    return nil
end

if not FlintLock._gbHubPatched then
    originalBayonetHitCheck = FlintLock.BayonetHitCheck
    FlintLock.BayonetHitCheck = function(self, startPos, direction, raycastParams, alreadyHit)
        local rayResult = Workspace:Raycast(startPos, direction, raycastParams)
        if rayResult then
            local parent = rayResult.Instance.Parent
            if parent and parent.Name == "m_Zombie" then
                local orig = parent:FindFirstChild("Orig")
                if orig and orig.Value then
                    local headPart = getZombieHead(parent)
                    if headPart then
                        self.remoteEvent:FireServer(
                            "Bayonet_HitZombie", orig.Value,
                            headPart.CFrame.Position, true, "Head"
                        )
                        return 1
                    end
                end
            end
        end
        return originalBayonetHitCheck(self, startPos, direction, raycastParams, alreadyHit)
    end

    originalMeleeHitCheck = MeleeBase.MeleeHitCheck
    MeleeBase.MeleeHitCheck = function(self, startPos, direction, raycastParams, hitTable, isCharge)
        local rayResult = Workspace:Raycast(startPos, direction, raycastParams)
        if rayResult then
            local parent = rayResult.Instance.Parent
            if parent and parent.Name == "m_Zombie" then
                local orig = parent:FindFirstChild("Orig")
                if orig and orig.Value then
                    local headPart = getZombieHead(parent)
                    if headPart then
                        local directionVec = headPart.CFrame.Position - startPos
                        if directionVec:Dot(directionVec) > 1 then
                            directionVec = directionVec.Unit
                        end
                        self.remoteEvent:FireServer(
                            "HitZombie", orig.Value,
                            headPart.CFrame.Position, true,
                            directionVec * 25, "Head", rayResult.Normal
                        )
                        return 1
                    end
                end
            end
        end
        return originalMeleeHitCheck(self, startPos, direction, raycastParams, hitTable, isCharge)
    end

    FlintLock._gbHubPatched = true
end

