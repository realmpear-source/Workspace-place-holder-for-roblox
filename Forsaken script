local namecallHook
namecallHook = hookmetamethod(game, "__namecall", function(self, ...)
    local args   = { ... }
    local method = getnamecallmethod():lower()
    if not checkcaller()
        and self.Name == "RemoteEvent"
        and method == "fireserver"
        and args[1] == "UpdateAccuracy"
    then
        args[2] = 100
        return namecallHook(self, unpack(args))
    end
    return namecallHook(self, ...)
end)

-- ========== KILL AURA ==========
local function getCurrentWeapon()
    local char = localPlayer.Character
    if not char then return nil end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then return tool end
    for _, child in ipairs(localPlayer.Backpack:GetChildren()) do
        if child:IsA("Tool") then return child end
    end
    return nil
end

local function matchesWeaponPattern(weaponName)
    for _, pattern in ipairs(CONFIG.KillAura.WeaponPatterns) do
        if string.match(weaponName, pattern) then return true end
    end
    return false
end

local function attackZombie(zombieModel, weaponName, headPart, hrp)
    -- Safe traversal: each step uses FindFirstChild so no index error if a
    -- folder disappears between the aura tick starting and this call.
    local orig = zombieModel:FindFirstChild("Orig")
    if not orig or not orig.Value then return end

    local headPos  = headPart.CFrame.Position
    local direction = headPos - hrp.CFrame.Position

    -- Reuse the pre-allocated RaycastParams; update filter for current char
    local rayResult = Workspace:Raycast(hrp.CFrame.Position, direction, State.killAuraRayParams)
    if not rayResult or rayResult.Instance.Parent ~= zombieModel then return end

    local forceDir = direction
    if forceDir:Dot(forceDir) > 1 then
        forceDir = forceDir.Unit
    end
    local force = forceDir * 25

    -- Safe path to the weapon's RemoteEvent
    local playersFolder = Workspace:FindFirstChild("Players")
    local playerFolder  = playersFolder and playersFolder:FindFirstChild(localPlayer.Name)
    local weaponFolder  = playerFolder  and playerFolder:FindFirstChild(weaponName)
    local remoteEvent   = weaponFolder  and weaponFolder:FindFirstChild("RemoteEvent")
    if not remoteEvent then return end

    remoteEvent:FireServer("Swing", "Thrust")
    remoteEvent:FireServer("HitZombie", orig.Value, headPos, true, force, "Head", rayResult.Normal)
    ReplicatedStorage.Remotes.Gib:FireServer(orig.Value, "Head", headPos, rayResult.Normal, true)
end

local function killAuraLoop()
    while State.killAuraActive do
        local char = localPlayer.Character
        if not char then task.wait(0.1); continue end
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then task.wait(0.1); continue end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then task.wait(0.1); continue end

        local weapon = getCurrentWeapon()
        if not weapon or not matchesWeaponPattern(weapon.Name) then
            task.wait(0.1)
            continue
        end
        local weaponName = weapon.Name

        -- Update the filter on the reused params to match the current character
        State.killAuraRayParams.FilterDescendantsInstances     = { char }
        State.killAuraOverlapParams.FilterDescendantsInstances = { char }

        -- Create hitbox once; reuse every subsequent tick
        local hitbox = hrp:FindFirstChild("GBHitbox")
        if not hitbox then
            hitbox      = Instance.new("Part")
            hitbox.Name = "GBHitbox"
            hitbox.Size = Vector3.new(
                CONFIG.KillAura.Range * 2, 7, CONFIG.KillAura.Range * 2
            )
            hitbox.Transparency = 1
            hitbox.CanCollide   = false
            hitbox.Anchored     = false
            hitbox.Parent       = hrp
            local weld  = Instance.new("WeldConstraint")
            weld.Part0  = hitbox
            weld.Part1  = hrp
            weld.Parent = hitbox
        end

        local partsInRange = Workspace:GetPartsInPart(hitbox, State.killAuraOverlapParams)
        local zombiesHit   = {}

        for _, part in ipairs(partsInRange) do
            local parent = part.Parent
            if parent
                and parent.Name == "m_Zombie"
                and not zombiesHit[parent]
            then
                -- Early-exit: must have Orig and be alive
                local orig     = parent:FindFirstChild("Orig")
                local zHumano  = parent:FindFirstChildOfClass("Humanoid")
                if orig and orig.Value and zHumano and zHumano.Health > 0 then
                    local headPart = getZombieHead(parent)
                    if headPart then
                        attackZombie(parent, weaponName, headPart, hrp)
                        zombiesHit[parent] = true
                    end
                end
            end
        end

        task.wait(CONFIG.KillAura.Cooldown)
    end

    -- Clean up hitbox when aura deactivates
    local char = localPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hitbox = hrp and hrp:FindFirstChild("GBHitbox")
    if hitbox then hitbox:Destroy() end
end

local function toggleKillAura()
    State.killAuraActive = not State.killAuraActive
    State.errorHandler:Log(
        "KillAura",
        State.killAuraActive and "Enabled" or "Disabled",
        "Info"
    )

    if State.killAuraActive then
        -- Allocate reusable physics params once per activation
        local char = localPlayer.Character

        local rp = RaycastParams.new()
        rp.FilterDescendantsInstances = { char }
        rp.FilterType = Enum.RaycastFilterType.Exclude
        State.killAuraRayParams = rp

        local op = OverlapParams.new()
        op.FilterDescendantsInstances = { char }
        op.FilterType = Enum.RaycastFilterType.Exclude
        State.killAuraOverlapParams = op

        task.spawn(killAuraLoop)
    else
        -- Params will be GC'd; nil the references
        State.killAuraRayParams     = nil
        State.killAuraOverlapParams = nil
    end
end

-- ========== PLAYER ESP (MEDIC & INFECTION) ==========
local function removePlayerESP(model)
    local highlight = State.espHighlights[model]
    if highlight then
        highlight:Destroy()
        State.espHighlights[model] = nil
    end
end

local function updateInventoryState()
    local hasMedical = false
    local hasMercy   = false
    local function checkTool(tool)
        if tool.Name == "Medical Supplies" then hasMedical = true end
        if tool.Name == "Mercy"            then hasMercy   = true end
    end
    for _, tool in ipairs(localPlayer.Backpack:GetChildren()) do
        if tool:IsA("Tool") then checkTool(tool) end
    end
    if localPlayer.Character then
        for _, tool in ipairs(localPlayer.Character:GetChildren()) do
            if tool:IsA("Tool") then checkTool(tool) end
        end
    end
    State.inventoryState.hasMedical = hasMedical
    State.inventoryState.hasMercy   = hasMercy
end

local function setupInventoryTracking()
    -- Backpack changes
    State.espConnections:Add(localPlayer.Backpack.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then updateInventoryState() end
    end))
    State.espConnections:Add(localPlayer.Backpack.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") then updateInventoryState() end
    end))

    -- Per-character tool tracking; connections registered into espConnections
    -- so they are all torn down on cleanup() without a separate table.
    local function connectCharTools(character)
        if not character then return end
        State.espConnections:Add(character.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then updateInventoryState() end
        end))
        State.espConnections:Add(character.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") then updateInventoryState() end
        end))
    end

    State.espConnections:Add(localPlayer.CharacterAdded:Connect(function(character)
        connectCharTools(character)
        updateInventoryState()
    end))

    if localPlayer.Character then
        connectCharTools(localPlayer.Character)
    end

    updateInventoryState()
end

local function setupESPPlayerTracking()
    local function addModel(model)
        if model and model:IsA("Model") then
            State.espPlayerModels[model] = true
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            if player.Character then addModel(player.Character) end

            -- CharacterAdded: new model for this existing player
            State.espConnections:Add(player.CharacterAdded:Connect(function(char)
                addModel(char)
            end))

            -- CharacterRemoving: immediately clean up highlight for old model
            State.espConnections:Add(player.CharacterRemoving:Connect(function(oldChar)
                removePlayerESP(oldChar)
                State.espPlayerModels[oldChar] = nil
            end))
        end
    end

    State.espConnections:Add(Players.PlayerAdded:Connect(function(player)
        if player == localPlayer then return end
        if player.Character then addModel(player.Character) end

        State.espConnections:Add(player.CharacterAdded:Connect(function(char)
            addModel(char)
        end))
        State.espConnections:Add(player.CharacterRemoving:Connect(function(oldChar)
            removePlayerESP(oldChar)
            State.espPlayerModels[oldChar] = nil
        end))
    end))

    State.espConnections:Add(Players.PlayerRemoving:Connect(function(player)
        local model = player.Character
        if model then
            removePlayerESP(model)
            State.espPlayerModels[model] = nil
        end
    end))
end

local function updatePlayerESP()
    if not State.playerESPActive then
        for model, highlight in pairs(State.espHighlights) do
            if highlight then highlight:Destroy() end
        end
        State.espHighlights = {}
        return
    end

    local playersFolder = Workspace:FindFirstChild("Players")
    if not playersFolder then return end

    local hasMedical = State.inventoryState.hasMedical
    local hasMercy   = State.inventoryState.hasMercy

    -- Nothing to highlight; clear and bail early
    if not hasMedical and not hasMercy then
        for model, highlight in pairs(State.espHighlights) do
            if highlight then highlight:Destroy() end
        end
        State.espHighlights = {}
        return
    end

    for model in pairs(State.espPlayerModels) do
        -- Stale model (character was replaced or removed)
        if not model.Parent or model.Parent ~= playersFolder then
            removePlayerESP(model)
            State.espPlayerModels[model] = nil
            continue
        end

        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            removePlayerESP(model)
            continue
        end

        local shouldHighlight = false
        local color = CONFIG.PlayerESP.MedicColor

        if hasMedical and humanoid.Health < 60 then
            shouldHighlight = true
            color = CONFIG.PlayerESP.MedicColor
        end

        if hasMercy then
            local userStates = model:FindFirstChild("UserStates")
            if userStates then
                local infected = userStates:FindFirstChild("Infected")
                if infected and infected.Value > 10 then
                    shouldHighlight = true
                    color = infected.Value > 89
                        and CONFIG.PlayerESP.InfectionHighColor
                        or  CONFIG.PlayerESP.InfectionLowColor
                end
            end
        end

        if shouldHighlight then
            local highlight = State.espHighlights[model]
            if not highlight then
                highlight               = Instance.new("Highlight")
                highlight.Adornee       = model
                highlight.FillTransparency    = 0.8
                highlight.OutlineTransparency = 0.2
                highlight.Parent        = model
                State.espHighlights[model] = highlight
            end
            highlight.FillColor    = color
            highlight.OutlineColor = color
        else
            removePlayerESP(model)
        end
    end
end

local function startPlayerESPLoop()
    if not State._espTrackingSet then
        setupInventoryTracking()
        setupESPPlayerTracking()
        State._espTrackingSet = true
    end

    while State.playerESPActive do
        safeCall(updatePlayerESP, "PlayerESP", true)
        task.wait(CONFIG.PlayerESP.UpdateInterval)
    end

    -- Cleanup highlights on toggle-off
    safeCall(function()
        for model, highlight in pairs(State.espHighlights) do
            if highlight then highlight:Destroy() end
        end
        State.espHighlights = {}
    end, "PlayerESPCleanup", true)
end

local function togglePlayerESP()
    State.playerESPActive = not State.playerESPActive
    State.errorHandler:Log(
        "PlayerESP",
        State.playerESPActive and "Enabled" or "Disabled",
        "Info"
    )
    if State.playerESPActive then
        task.spawn(startPlayerESPLoop)
    end
end

-- ========== INPUT HANDLING ==========
local function setupInputHandlers()
    State.connections:Add(UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == CONFIG.KillAura.Keybind then
            toggleKillAura()
        elseif input.KeyCode == CONFIG.PlayerESP.Keybind then
            togglePlayerESP()
        end
    end))
end

-- ========== INITIALIZATION ==========
local function initialize()
    safeCall(function()
        setupInputHandlers()
        State.playerESPActive = false
        State.killAuraActive  = false
        State.errorHandler:Log(
            "Init",
            "Script initialized (Kill Aura off, Player ESP off)",
            "Info"
        )
        print("G&B Hub Revamped - Press F1 for Kill Aura, F2 for Player ESP")
    end, "Init")
    return true
end

local function cleanup()
    safeCall(function()
        State.killAuraActive  = false
        State.playerESPActive = false

        State.connections:Destroy()
        State.espConnections:Destroy()

        -- Restore original weapon functions only if we were the ones who patched them
        if FlintLock._gbHubPatched then
            FlintLock.BayonetHitCheck  = originalBayonetHitCheck
            MeleeBase.MeleeHitCheck    = originalMeleeHitCheck
            FlintLock._gbHubPatched    = false
        end

        for _, highlight in pairs(State.espHighlights) do
            if highlight then highlight:Destroy() end
        end
        State.espHighlights   = {}
        State.espPlayerModels = {}

        State.killAuraRayParams     = nil
        State.killAuraOverlapParams = nil
    end, "Cleanup", true)
end

-- ========== MAIN ==========
local success = safeCall(initialize, "Main")
if not success then cleanup() end

_G.GBHubInstance = {
    cleanup        = cleanup,
    toggleKillAura = toggleKillAura,
    togglePlayerESP = togglePlayerESP,
}
