-- ========== CONNECTION MANAGER ==========
local ConnectionManager = {}
ConnectionManager.__index = ConnectionManager

function ConnectionManager.new()
    return setmetatable({ _connections = {} }, ConnectionManager)
end

function ConnectionManager:Add(connection)
    if connection then
        table.insert(self._connections, connection)
    end
    return connection
end

function ConnectionManager:DisconnectAll()
    for _, connection in ipairs(self._connections) do
        if typeof(connection) == "RBXScriptConnection" then
            connection:Disconnect()
        end
    end
    self._connections = {}
end

function ConnectionManager:Destroy()
    self:DisconnectAll()
end

-- ========== ERROR HANDLER ==========
local ErrorHandler = {}
ErrorHandler.__index = ErrorHandler

function ErrorHandler.new()
    return setmetatable({
        errors = {},
        maxErrors = 50,
        enabled = true,
        logToConsole = true
    }, ErrorHandler)
end

function ErrorHandler:Log(context, errorMsg, level, suppressOutput)
    if not self.enabled then return end

    level = level or "Warning"
    local timestamp = os.date("%H:%M:%S")
    local entry = {
        context = context,
        errorMsg = errorMsg,
        traceback = errorMsg,
        level = level,
        timestamp = timestamp
    }

    table.insert(self.errors, entry)
    if #self.errors > self.maxErrors then
        table.remove(self.errors, 1)
    end

    if self.logToConsole and not suppressOutput then
        print(string.format("[%s][%s] %s: %s", timestamp, level, context, errorMsg))
    end

    return entry
end

function ErrorHandler:Clear()
    self.errors = {}
end

function ErrorHandler:GetRecent(count)
    count = math.min(count or 5, #self.errors)
    local result = {}
    for i = #self.errors, #self.errors - count + 1, -1 do
        local entry = self.errors[i]
        if entry then
            table.insert(result, string.format("[%s][%s] %s: %s",
                entry.timestamp, entry.level, entry.context, entry.errorMsg))
        end
    end
    return result
end

function ErrorHandler:Enable() self.enabled = true end
function ErrorHandler:Disable() self.enabled = false end
function ErrorHandler:SetConsoleLogging(enabled) self.logToConsole = enabled end

