-- ========== HIGHLIGHT MANAGEMENT ==========
local function cleanupHighlight(parent)
    safeCall(function()
        local highlight = State.activeHighlights[parent]
        if highlight and highlight.Parent then
            highlight:Destroy()
        end
        State.activeHighlights[parent] = nil
    end, "cleanupHighlight", true)
end

local function clearAllHighlights()
    safeCall(function()
        for _, highlight in pairs(State.activeHighlights) do
            if highlight and highlight.Parent then
                highlight:Destroy()
            end
        end
        table.clear(State.activeHighlights)

        if highlightContainer then
            for _, child in ipairs(highlightContainer:GetChildren()) do
                child:Destroy()
            end
        end
    end, "clearAllHighlights", true)
end

local function createHighlight(parent, color, fillTransparency, outlineTransparency)
    if not parent or not parent.Parent then return nil end
    if State.activeHighlights[parent] then return nil end
    if not highlightContainer or not highlightContainer.Parent then return nil end

    return safeCall(function()
        local highlight = Instance.new("Highlight")
        highlight.FillColor = color or Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = fillTransparency or 0.5
        highlight.OutlineColor = color or Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = outlineTransparency or 0.2
        highlight.Adornee = parent
        highlight.Parent = highlightContainer

        State.activeHighlights[parent] = highlight

        local ancestryConn
        ancestryConn = parent.AncestryChanged:Connect(function(_, newParent)
            if newParent == nil then
                cleanupHighlight(parent)
                ancestryConn:Disconnect()
            end
        end)
        State.highlightConnections:Add(ancestryConn)

        return highlight
    end, "createHighlight") or nil
end

-- ========== PLAYER EQUIPMENT TRACKING ==========
local function updatePlayerEquipment()
    return safeCall(function()
        State.playerEquipment = {
            hasMedicalSupplies = false,
            hasMercy = false
        }
        
        local character = localPlayer.Character
        if character then
            if character:FindFirstChild("Medical Supplies") and character["Medical Supplies"]:IsA("Tool") then
                State.playerEquipment.hasMedicalSupplies = true
            end
            if character:FindFirstChild("Mercy") and character["Mercy"]:IsA("Tool") then
                State.playerEquipment.hasMercy = true
            end
        end
        
        local backpack = localPlayer.Backpack
        if backpack then
            if backpack:FindFirstChild("Medical Supplies") then
                State.playerEquipment.hasMedicalSupplies = true
            end
            if backpack:FindFirstChild("Mercy") then
                State.playerEquipment.hasMercy = true
            end
        end
        
        return State.playerEquipment
    end, "updatePlayerEquipment", true) or State.playerEquipment
end

-- ========== PLAYER ESP ==========
local function shouldHighlightPlayer(playerModel)
    if not playerModel or not playerModel.Parent then return false, nil end
    if isLocalPlayerModel(playerModel) then return false, nil end
    
    local humanoid = playerModel:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false, nil end
    
    local health = humanoid.Health
    local equipment = updatePlayerEquipment()
    
    -- Medic ESP (low health players)
    if equipment.hasMedicalSupplies and health < PLAYER_ESP_SETTINGS.lowHealthThreshold then
        return true, COLORS.lowHealth, 0.8, 0.2
    end
    
    -- Father Infection ESP
    if equipment.hasMercy then
        local userStates = playerModel:FindFirstChild("UserStates")
        if userStates then
            local infectedValue = userStates:FindFirstChild("Infected")
            if infectedValue then
                local infection = infectedValue.Value
                if infection > 0 then
                    if infection > PLAYER_ESP_SETTINGS.highInfectionThreshold then
                        return true, COLORS.highInfection, 0.5, 0.2
                    else
                        return true, COLORS.infected, 0.8, 0.2
                    end
                end
            end
        end
    end
    
    return false, nil
end

local function updatePlayerHighlights()
    if not State.espEnabled then return end
    
    safeCall(function()
        local playersFolder = Workspace:FindFirstChild("Players")
        if not playersFolder then return end
        
        local equipment = updatePlayerEquipment()
        
        local function processPlayerGroup(group)
            if not group then return end
            
            for _, playerModel in ipairs(group:GetChildren()) do
                if playerModel:IsA("Model") then
                    local shouldHighlight, color, fillTrans, outlineTrans = shouldHighlightPlayer(playerModel, equipment)
                    
                    if shouldHighlight then
                        local existing = State.activeHighlights[playerModel]
                        if existing then
                            existing.FillColor = color
                            existing.FillTransparency = fillTrans
                            existing.OutlineColor = color
                            existing.OutlineTransparency = outlineTrans
                        else
                            createHighlight(playerModel, color, fillTrans, outlineTrans)
                        end
                    else
                        cleanupHighlight(playerModel)
                    end
                end
            end
        end
        
        processPlayerGroup(playersFolder:FindFirstChild("Survivors"))
        processPlayerGroup(playersFolder:FindFirstChild("Killers"))
        
        -- Also check for players that might be in other folders
        for _, child in ipairs(playersFolder:GetChildren()) do
            if child:IsA("Model") and child.Name ~= "Survivors" and child.Name ~= "Killers" then
                local shouldHighlight, color, fillTrans, outlineTrans = shouldHighlightPlayer(child, equipment)
                if shouldHighlight then
                    local existing = State.activeHighlights[child]
                    if existing then
                        existing.FillColor = color
                        existing.FillTransparency = fillTrans
                        existing.OutlineColor = color
                        existing.OutlineTransparency = outlineTrans
                    else
                        createHighlight(child, color, fillTrans, outlineTrans)
                    end
                else
                    cleanupHighlight(child)
                end
            end
        end
    end, "updatePlayerHighlights", true)
end

-- ========== KILL AURA ==========
local function getAllZombiesInRange(rootPart, range)
    local zombiesInRange = {}
    
    safeCall(function()
        local zombiesFolder = Workspace:FindFirstChild("Zombies") or Workspace:FindFirstChild("m_Zombie")
        if not zombiesFolder then
            -- Fallback: search workspace for zombies
            for _, descendant in ipairs(Workspace:GetDescendants()) do
                if descendant.Name == "m_Zombie" and descendant:IsA("Model") then
                    local zroot = descendant:FindFirstChild("HumanoidRootPart") or descendant:FindFirstChild("Orig") and descendant.Orig.Value and descendant.Orig.Value:FindFirstChild("HumanoidRootPart")
                    if zroot then
                        local distance = (zroot.Position - rootPart.Position).Magnitude
                        if distance <= range then
                            table.insert(zombiesInRange, {
                                model = descendant,
                                rootPart = zroot,
                                distance = distance
                            })
                        end
                    end
                end
            end
            return
        end
        
        for _, zombie in ipairs(zombiesFolder:GetChildren()) do
            if zombie:IsA("Model") then
                local zroot = zombie:FindFirstChild("HumanoidRootPart")
                if not zroot then
                    local orig = zombie:FindFirstChild("Orig")
                    if orig and orig.Value then
                        zroot = orig.Value:FindFirstChild("HumanoidRootPart")
                    end
                end
                
                if zroot then
                    local distance = (zroot.Position - rootPart.Position).Magnitude
                    if distance <= range then
                        table.insert(zombiesInRange, {
                            model = zombie,
                            rootPart = zroot,
                            distance = distance
                        })
                    end
                end
            end
        end
    end, "getAllZombiesInRange", true)
    
    -- Sort by distance (closest first)
    table.sort(zombiesInRange, function(a, b)
        return a.distance < b.distance
    end)
    
    return zombiesInRange
end

local function getZombieHead(zombie)
    return safeCall(function()
        -- Check for direct Head child
        local head = zombie:FindFirstChild("Head")
        if head and (head:IsA("Part") or head:IsA("MeshPart")) then
            return head
        end
        
        -- Check in Orig value
        local orig = zombie:FindFirstChild("Orig")
        if orig and orig.Value then
            head = orig.Value:FindFirstChild("Head")
            if head and (head:IsA("Part") or head:IsA("MeshPart")) then
                return head
            end
        end
        
        -- Search all children for Head
        for _, child in ipairs(zombie:GetChildren()) do
            if child.Name == "Head" and (child:IsA("Part") or child:IsA("MeshPart")) then
                return child
            end
        end
        
        return nil
    end, "getZombieHead", true)
end

local function attackZombie(zombieInfo, weaponRemote, rootPart)
    if not weaponRemote or not rootPart then return false end
    
    return safeCall(function()
        local head = getZombieHead(zombieInfo.model)
        if not head then return false end
        
        local gibRemote = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Gib")
        
        local hitPos = head.Position
        local direction = (hitPos - rootPart.Position).Unit
        local knockback = direction * 25
        
        local zombieTarget = zombieInfo.model
        local orig = zombieTarget:FindFirstChild("Orig")
        local actualZombie = orig and orig.Value or zombieTarget
        
        -- Fire Swing
        weaponRemote:FireServer("Swing", "Thrust")
        
        -- Fire Gib if available
        if gibRemote then
            gibRemote:FireServer(actualZombie, "Head", hitPos, direction, true)
        end
        
        -- Fire HitZombie
        weaponRemote:FireServer("HitZombie", actualZombie, hitPos, true, knockback, "Head", direction)
        
        return true
    end, "attackZombie", true) or false
end

local function executeKillAura()
    if not State.killAuraEnabled then return end
    if not isPlayerAlive() then return end
    
    safeCall(function()
        local rootPart = getLocalPlayerRoot()
        if not rootPart then return end
        
        local weaponRemote, weaponName = findCurrentWeaponRemote()
        if not weaponRemote then
            State.errorHandler:Log("KillAura", "No compatible weapon found", "Warning", true)
            return
        end
        
        local zombies = getAllZombiesInRange(rootPart, KILL_AURA_CONFIG.Range)
        
        if #zombies > 0 then
            State.errorHandler:Log("KillAura", string.format("Attacking %d zombie(s) with %s", #zombies, weaponName or "Unknown"), "Info", true)
        end
        
        -- Hit all zombies in range at once
        for _, zombieInfo in ipairs(zombies) do
            attackZombie(zombieInfo, weaponRemote, rootPart)
            task.wait(0.05) -- Small delay between attacks to prevent overwhelming
        end
    end, "executeKillAura", true)
end

-- ========== AUTO-PLAY (ALWAYS ACTIVE) ==========
local function setupAutoPlay()
    local namecall = nil
    
    namecall = hookmetamethod(game, "__namecall", function(self, ...)
        local args = {...}
        local method = getnamecallmethod():lower()
        
        if not checkcaller() and self.Name == "RemoteEvent" and method == "fireserver" then
            if args[1] == "UpdateAccuracy" then
                args[2] = 100
                return namecall(self, unpack(args))
            end
        end
        return namecall(self, ...)
    end)
    
    State.errorHandler:Log("AutoPlay", "Auto-Play is always active", "Info")
end

-- ========== HEAD LOCK (ALWAYS ACTIVE) ==========
local function setupHeadLock()
    safeCall(function()
        -- Hook Flintlock BayonetHitCheck
        local FlintLock = pcall(function()
            return require(ReplicatedStorage.Modules.Weapons.Flintlock)
        end)
        
        if FlintLock then
            local originFlintlockFunction = FlintLock.BayonetHitCheck
            
            FlintLock.BayonetHitCheck = function(p115, p116, p117, p118, p119)
                local v120 = Workspace:Raycast(p116, p117, p118)
                if v120 then
                    if v120.Instance.Parent.Name == "m_Zombie" then
                        local v123 = v120.Instance.Parent:FindFirstChild("Orig")
                        if v123 then
                            local Head = nil
                            for i, part in pairs(v120.Instance.Parent:GetChildren()) do
                                if part.Name == "Head" and (part.ClassName == "Part" or part.ClassName == "MeshPart") then
                                    Head = part
                                end
                            end
                            if Head then
                                p115.remoteEvent:FireServer("Bayonet_HitZombie", v123.Value, Head.CFrame.Position, true, "Head")
                                local v_u_124 = v123.Value
                                local v_u_125 = tick()
                                v_u_124:SetAttribute("WepHitID", tick())
                                v_u_124:SetAttribute("WepHitDirection", p117 * 10)
                                v_u_124:SetAttribute("WepHitPos", v120.Position)
                                task.delay(0.2, function()
                                    if v_u_124:GetAttribute("WepHitID") == v_u_125 then
                                        v_u_124:SetAttribute("WepHitDirection", nil)
                                        v_u_124:SetAttribute("WepHitPos", nil)
                                        v_u_124:SetAttribute("WepHitID", nil)
                                    end
                                end)
                            end
                            return 1
                        end
                    end
                end
                return originFlintlockFunction(p115, p116, p117, p118, p119)
            end
        end
        
        -- Hook MeleeBase MeleeHitCheck
        local MeleeBase = pcall(function()
            return require(ReplicatedStorage.Modules.Weapons.MeleeBase)
        end)
        
        if MeleeBase then
            local originMeleeFunction = MeleeBase.MeleeHitCheck
            
            MeleeBase.MeleeHitCheck = function(p100, p101, p102, p103, p104, p105)
                local v106 = Workspace:Raycast(p101, p102, p103)
                if v106 then
                    if v106.Instance.Parent.Name == "m_Zombie" then
                        local v109 = v106.Instance.Parent:FindFirstChild("Orig")
                        if v109 then
                            local Head = nil
                            for i, part in pairs(v106.Instance.Parent:GetChildren()) do
                                if part.Name == "Head" and (part.ClassName == "Part" or part.ClassName == "MeshPart") then
                                    Head = part
                                end
                            end
                            if Head then
                                if p105 then
                                    p100.remoteEvent:FireServer("ThrustCharge", v109.Value, v106.Position, v106.Normal)
                                else
                                    local u112 = v109.Value
                                    local v113 = Head.CFrame.Position - p101
                                    if v113:Dot(v113) > 1 then
                                        v113 = v113.Unit
                                    end
                                    local v114 = v113 * 25
                                    p100.remoteEvent:FireServer("HitZombie", u112, Head.CFrame.Position, true, v114, "Head", v106.Normal)
                                end
                            end
                            return 1
                        end
                    end
                end
                return originMeleeFunction(p100, p101, p102, p103, p104, p105)
            end
        end
        
        State.errorHandler:Log("HeadLock", "Head Lock is always active", "Info")
    end, "setupHeadLock", true)
end

-- ========== WEAPON EQUIP/UNEQUIP HANDLING ==========
local function onToolEquipped(tool)
    safeCall(function()
        if tool.Name == "Medical Supplies" or tool.Name == "Mercy" then
            updatePlayerEquipment()
            updatePlayerHighlights()
        end
    end, "onToolEquipped", true)
end

local function onToolUnequipped(tool)
    safeCall(function()
        if tool.Name == "Medical Supplies" or tool.Name == "Mercy" then
            updatePlayerEquipment()
            -- Re-scan highlights since equipment changed
            if State.espEnabled then
                updatePlayerHighlights()
            end
        end
    end, "onToolUnequipped", true)
end

local function setupToolHandlers()
    safeCall(function()
        local character = localPlayer.Character
        if character then
            for _, tool in ipairs(character:GetChildren()) do
                if tool:IsA("Tool") then
                    if tool.Name == "Medical Supplies" or tool.Name == "Mercy" then
                        onToolEquipped(tool)
                    end
                end
            end
        end
        
        State.connections:Add(localPlayer.CharacterAdded:Connect(function(character)
            character.ChildAdded:Connect(function(child)
                if child:IsA("Tool") then
                    if child.Name == "Medical Supplies" or child.Name == "Mercy" then
                        onToolEquipped(child)
                    end
                end
            end)
            character.ChildRemoved:Connect(function(child)
                if child:IsA("Tool") then
                    if child.Name == "Medical Supplies" or child.Name == "Mercy" then
                        onToolUnequipped(child)
                    end
                end
            end)
        end))
        
        local backpack = localPlayer.Backpack
        backpack.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then
                if child.Name == "Medical Supplies" or child.Name == "Mercy" then
                    updatePlayerEquipment()
                end
            end
        end)
        backpack.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") then
                if child.Name == "Medical Supplies" or child.Name == "Mercy" then
                    updatePlayerEquipment()
                    updatePlayerHighlights()
                end
            end
        end)
    end, "setupToolHandlers", true)
end

-- ========== INPUT HANDLING ==========
local function setupInputHandlers()
    -- F1: Toggle Kill Aura
    State.connections:Add(UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == KILL_AURA_CONFIG.ToggleKey then
            State.killAuraEnabled = not State.killAuraEnabled
            State.errorHandler:Log("Input", "Kill Aura " .. (State.killAuraEnabled and "ENABLED" or "DISABLED"), "Info")
        end
    end))
    
    -- F2: Toggle ESP
    State.connections:Add(UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == ESP_CONFIG.ToggleKey then
            State.espEnabled = not State.espEnabled
            if State.espEnabled then
                updatePlayerHighlights()
            else
                clearAllHighlights()
            end
            State.errorHandler:Log("Input", "ESP " .. (State.espEnabled and "ENABLED" or "DISABLED"), "Info")
        end
    end))
    
    -- F1 + F2 combo for status (optional)
    State.connections:Add(UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == KILL_AURA_CONFIG.ToggleKey and UserInputService:IsKeyDown(ESP_CONFIG.ToggleKey) then
            State.errorHandler:Log("Status", string.format("Kill Aura: %s, ESP: %s", 
                State.killAuraEnabled and "ON" or "OFF",
                State.espEnabled and "ON" or "OFF"), "Info")
        end
    end))
end

local function setupKillAuraManualTrigger()
    -- Manual trigger for Kill Aura when E is pressed while Kill Aura is enabled
    State.connections:Add(UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.E and State.killAuraEnabled then
            task.spawn(executeKillAura)
        end
    end))
end

-- ========== EVENT HANDLERS ==========
local function onCharacterDeath()
    State.characterDied = true
    clearAllHighlights()
end

local function onCharacterAdded(character)
    State.characterDied = false
    
    safeCall(function()
        local humanoid = character:WaitForChild("Humanoid", 5)
        if humanoid then
            humanoid.Died:Connect(onCharacterDeath)
        end
        
        task.wait(1)
        
        setupHighlightContainer()
        
        if State.espEnabled then
            updatePlayerHighlights()
        end
    end, "onCharacterAdded", true)
end

local function setupRespawnHandling()
    local playersFolder = Workspace:FindFirstChild("Players")
    if not playersFolder then return end
    
    local function cleanupOnDeath(playerModel)
        if not isLocalPlayerModel(playerModel) then
            cleanupHighlight(playerModel)
        end
    end
    
    local function setupDeathTrackingForGroup(group)
        if not group then return end
        
        for _, playerModel in ipairs(group:GetChildren()) do
            if playerModel:IsA("Model") then
                local humanoid = playerModel:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid.Died:Connect(function()
                        cleanupOnDeath(playerModel)
                    end)
                end
            end
        end
        
        group.ChildAdded:Connect(function(child)
            if child:IsA("Model") then
                local humanoid = child:WaitForChild("Humanoid", 2)
                if humanoid then
                    humanoid.Died:Connect(function()
                        cleanupOnDeath(child)
                    end)
                end
            end
        end)
    end
    
    setupDeathTrackingForGroup(playersFolder:FindFirstChild("Survivors"))
    setupDeathTrackingForGroup(playersFolder:FindFirstChild("Killers"))
end

-- ========== INITIALIZATION ==========
local function initialize()
    if not localPlayer then
        State.errorHandler:Log("Initialization", "Failed to get local player", "Error")
        return false
    end
    
    safeCall(function()
        setupHighlightContainer()
        setupInputHandlers()
        setupKillAuraManualTrigger()
        setupToolHandlers()
        setupAutoPlay()
        setupHeadLock()
        
        if localPlayer.Character then
            local humanoid = localPlayer.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.Died:Connect(onCharacterDeath)
            end
        end
        
        State.connections:Add(localPlayer.CharacterAdded:Connect(onCharacterAdded))
        
        setupRespawnHandling()
        
        -- Periodic ESP update
        State.connections:Add(RunService.Heartbeat:Connect(function()
            if State.espEnabled and os.clock() - State.lastHighlightUpdate > ESP_CONFIG.RefreshRate then
                updatePlayerHighlights()
                State.lastHighlightUpdate = os.clock()
            end
        end))
        
        if State.espEnabled then
            updatePlayerHighlights()
        end
        
        State.errorHandler:Log("Initialization", "G&B Hub script initialized successfully", "Info")
        
        -- Print status message
        print([[

╔══════════════════════════════════════════════════════════════╗
║                    G&B Hub - Xavier I.N.C                    ║
╠══════════════════════════════════════════════════════════════╣
