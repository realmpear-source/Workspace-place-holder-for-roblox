-- ========== UTILITY ==========
local function safeCall(func, context, suppressError)
    local handler = function(err)
        return debug.traceback(tostring(err), 2)
    end
    local success, result = xpcall(func, handler)
    if not success then
        State.errorHandler:Log(context or "Unknown", result, "Error", suppressError)
        return nil
    end
    return result
end

local function isPlayerAlive()
    if State.characterDied then return false end
    return safeCall(function()
        local character = localPlayer.Character
        if not character then return false end
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        return humanoid and humanoid.Health > 0
    end, "isPlayerAlive", true) or false
end

local function getLocalPlayerRoot()
    return safeCall(function()
        local character = localPlayer.Character
        return character and character:FindFirstChild("HumanoidRootPart")
    end, "getLocalPlayerRoot", true)
end

local function isValidObject(obj)
    return safeCall(function()
        return obj and (obj:IsA("Model") or obj:IsA("Part") or obj:IsA("BasePart"))
    end, "isValidObject", true) or false
end

local function isLocalPlayerModel(model)
    if not model or not localPlayer then return false end
    return model == localPlayer.Character
end

-- ========== WEAPON DETECTION ==========
local function findCurrentWeaponRemote()
    return safeCall(function()
        local character = localPlayer.Character
        if not character then return nil end
        
        for _, pattern in ipairs(KILL_AURA_CONFIG.WeaponPatterns) do
            for _, child in ipairs(character:GetChildren()) do
                if string.match(child.Name, pattern) then
                    local remote = child:FindFirstChild("RemoteEvent")
                    if remote then
                        return remote, child.Name
                    end
                end
            end
        end
        
        local backpack = localPlayer.Backpack
        if backpack then
            for _, pattern in ipairs(KILL_AURA_CONFIG.WeaponPatterns) do
                for _, child in ipairs(backpack:GetChildren()) do
                    if string.match(child.Name, pattern) then
                        local remote = child:FindFirstChild("RemoteEvent")
                        if remote then
                            return remote, child.Name
                        end
                    end
                end
            end
        end
        
        return nil, nil
    end, "findCurrentWeaponRemote", true)
end

