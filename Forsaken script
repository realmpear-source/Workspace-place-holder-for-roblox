║  Features:                                                   ║
║    • Player ESP (Low HP / Infected)                          ║
║    • Kill Aura (Manual trigger with E)                       ║
║    • Auto-Play (Always Active)                               ║
║    • Head Lock (Always Active)                               ║
╚══════════════════════════════════════════════════════════════╝
        ]])
    end, "initialize")
    
    return true
end

local function cleanup()
    safeCall(function()
        State.killAuraEnabled = false
        State.espEnabled = false
        
        State.connections:Destroy()
        State.highlightConnections:DisconnectAll()
        clearAllHighlights()
        
        if highlightContainer and highlightContainer.Parent then
            highlightContainer:Destroy()
            highlightContainer = nil
        end
        
        State.errorHandler:Log("Cleanup", "G&B Hub script cleaned up", "Info")
    end, "cleanup", true)
end

-- ========== MAIN ==========
local success = safeCall(initialize, "Main")
if not success then cleanup() end

_G.GBHubScriptInstance = {
    cleanup = cleanup,
    errorHandler = State.errorHandler,
    setKillAura = function(enabled) State.killAuraEnabled = enabled end,
    setESP = function(enabled) 
        State.espEnabled = enabled
        if enabled then updatePlayerHighlights() else clearAllHighlights() end
    end
}

return cleanup, State.errorHandler
